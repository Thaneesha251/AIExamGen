# ==========================================
# AI EXAMGEN - ENVIRONMENT CONFIGURATION
# ==========================================

# Application Settings
APP_NAME="AI ExamGen"
APP_ENV="development"
DEBUG=True
SECRET_KEY="change-this-super-secret-key-in-production-aiexamgen-2026"
API_V1_STR="/api/v1"

# Database Configuration
# PostgreSQL (Production / Docker): postgresql+psycopg2://postgres:postgres@localhost:5432/aiexamgen_db
# SQLite (Local Dev Fallback): sqlite:///./aiexamgen.db
DATABASE_URL="sqlite:///./aiexamgen.db"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# AI Provider Configuration
# Supported providers: google, openai, mock
AI_PROVIDER="google"
AI_MODEL="gemini-1.5-pro"
AI_API_KEY="your-ai-api-key-here"

# OCR Provider Configuration
# Supported providers: tesseract, easyocr, paddleocr, mock
OCR_PROVIDER="tesseract"
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Storage Settings
UPLOAD_DIR="storage/uploads"
MAX_UPLOAD_SIZE_MB=25

# JWT Settings
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"
